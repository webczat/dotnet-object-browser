{
  "name": "dotnet-object-browser-env",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "mounts": [
    "src=dotnet-object-browser-npm-cache,target=/home/vscode/.npm,type=volume",
    "src=dotnet-object-browser-nugets,target=/home/vscode/.nuget,type=volume"
  ],
  "updateContentCommand": "npm install",
  "features": {
    "ghcr.io/devcontainers/features/common-utils": {},
    "ghcr.io/devcontainers/features/github-cli": {},
    "ghcr.io/devcontainers/features/dotnet": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "ms-dotnettools.csdevkit",
        "Prettier.prettier-vscode",
        "ms-vscode.extension-test-runner",
        "GitHub.vscode-github-actions",
        "tintoy.msbuild-project-tools",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "fullSolution",
        "dotnet.backgroundAnalysis.compilerDiagnosticsScope": "fullSolution",
        "csharp.debug.justMyCode": false,
        "csharp.debug.symbolOptions.searchMicrosoftSymbolServer": true,
        "csharp.debug.symbolOptions.searchNuGetOrgSymbolServer": true,
        "csharp.debug.console": "internalConsole",
        "dotnet.formatting.organizeImportsOnFormat": true,
        "dotnet.navigation.navigateToSourceLinkAndEmbeddedSources": true,
        "dotnet.symbolSearch.searchReferenceAssemblies": true
      }
    }
  }
}
