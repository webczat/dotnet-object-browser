{
  "name": "dotnet-object-browser-env",
"image": "ubuntu",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "mounts": [
    "src=dotnet-object-browser-npm-cache,target=/home/ubuntu/.npm,type=volume",
    "src=dotnet-object-browser-nugets,target=/home/ubuntu/.nuget,type=volume"
  ],
  "onCreateCommand": {
    "permissions": "sudo chown -R ubuntu:ubuntu /home/ubuntu/.npm && sudo chown -R ubuntu:ubuntu /home/ubuntu/.nuget",
    "packages": "sudo apt update && sudo apt install -y xvfb xdg-utils"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils": {
      "installSsl": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/github-cli": {},
    "ghcr.io/devcontainers/features/dotnet": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "Prettier.prettier-vscode",
        "ms-vscode.extension-test-runner"
      ]
    }
  }
}
